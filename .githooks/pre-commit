#!/bin/sh
# Check staged source paths without modifying either the index or working tree.
#
# Wired via `core.hooksPath` (root `prepare` script), or manually:
#   git config core.hooksPath .githooks
# Bypass once with `git commit --no-verify`.
set -e

git diff --cached --name-only -z --diff-filter=ACMR | bun scripts/check-staged.ts
