generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model AgentRuntimeState {
  conversationId String @id
  version        Int
}

model AgentRuntimeRun {
  conversationId          String
  runId                   String
  assistantMessageId      String
  state                   String
  createdAt               DateTime
  payload                 String
  terminalAssistantPayload String?

  @@id([conversationId, runId])
  @@unique([conversationId, assistantMessageId])
  @@index([state, conversationId, runId])
}

model AgentRuntimeAdmission {
  conversationId    String
  idempotencyKey    String
  inputMessageId    String
  runId             String
  assistantMessageId String
  inputPayload      String

  @@id([conversationId, idempotencyKey])
  @@unique([conversationId, inputMessageId])
}

model AgentRuntimeSeed {
  conversationId String
  seedKey String
  payload String

  @@id([conversationId, seedKey])
}

model AgentRuntimeMessage {
  conversationId String
  id             String
  position       Int
  active         Boolean @default(true)
  payload        String

  @@id([conversationId, id])
}

model AgentRuntimeEvent {
  conversationId String
  seq            Int
  eventId        String   @unique
  schemaVersion  Int
  kind           String
  occurredAt     DateTime
  ignorable      Boolean
  payload        String

  @@id([conversationId, seq])
  @@index([conversationId, occurredAt])
}
