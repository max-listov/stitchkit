{
  "name": "stitchkit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && bun scripts/prepare-starter.ts",
    "dev": "bun --filter stitchkit dev",
    "check": "bun --filter stitchkit check && bun --filter create-stitchkit check && bun run check:template && bun run check:scripts",
    "check:template": "cd packages/create-stitchkit/template && bun run check",
    "check:scripts": "bun x tsc -p scripts/tsconfig.json",
    "test": "bun --filter stitchkit test && bun --filter create-stitchkit test && bun test scripts/*.test.ts && bun run test:template",
    "gen:llms": "bun scripts/gen-llms.ts",
    "build": "bun run gen:llms && bun run gen:example-declarations && bun --filter stitchkit build && bun --filter create-stitchkit build",
    "lint": "biome check --error-on-warnings . && bun run lint:template",
    "lint:template": "cd packages/create-stitchkit/template && bun run lint",
    "lint:fix": "biome check --write . && cd packages/create-stitchkit/template && bun run lint:fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "bun scripts/verify.ts",
    "verify:fast": "bun scripts/verify.ts --fast",
    "smoke:node": "bun --filter stitchkit smoke:node",
    "smoke:next-ssr": "bun --filter stitchkit smoke:next-ssr",
    "consumer-lane": "bun --filter stitchkit consumer-lane",
    "starter-lane": "bun scripts/starter-lane.ts --mode=target --variant=blank --browser=all && bun scripts/starter-lane.ts --mode=target --variant=repository --browser=all",
    "starter-head-lane": "bun scripts/starter-lane.ts --mode=head --variant=blank --browser=all && bun scripts/starter-lane.ts --mode=head --variant=repository --browser=all",
    "test:agent-store-postgres": "bun scripts/agent-store-postgres-lane.ts",
    "starter:dev": "cd packages/create-stitchkit/template && bun run dev",
    "update:starter": "bun scripts/update-starter.ts",
    "release:core": "bun scripts/release-plan.ts release core",
    "release:starter": "bun scripts/release-plan.ts release create-stitchkit",
    "sync:readme": "cp README.md packages/core/README.md && bun run gen:llms",
    "test:template": "cd packages/create-stitchkit/template && bun test scripts",
    "gen:example-declarations": "bun scripts/sync-example-declarations.ts",
    "supervised-lane": "bun scripts/supervised-lane.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "pm2": "^7.0.4",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
