{
  "name": "stitchkit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun --filter stitchkit dev",
    "check": "bun --filter stitchkit check && bun run check:scripts",
    "check:scripts": "bun x tsc -p scripts/tsconfig.json",
    "test": "bun --filter stitchkit test",
    "gen:llms": "bun scripts/gen-llms.ts",
    "build": "bun run gen:llms && bun --filter stitchkit build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "bun run lint && bun run check && bun run test && bun run build && bun run smoke:node && bun run consumer-lane",
    "smoke:node": "bun --filter stitchkit smoke:node",
    "consumer-lane": "bun --filter stitchkit consumer-lane",
    "sync:readme": "cp README.md packages/core/README.md",
    "release": "bun run sync:readme && bun run verify && cd packages/core && bun publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "typescript": "^6"
  }
}
