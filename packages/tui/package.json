{
  "name": "stitchkit-tui",
  "version": "0.1.4",
  "description": "Composable terminal UI for the Stitchkit headless agent runtime",
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/tui"
  },
  "type": "module",
  "bin": {
    "stitchkit-agent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts src/core/index.ts --root src --outdir dist --target bun --packages external && bun x tsc -p tsconfig.build.json --emitDeclarationOnly && chmod +x dist/cli.js",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "ai": "^7.0.111",
    "react": "^19.3.0",
    "stitchkit": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
