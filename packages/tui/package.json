{
  "name": "stitchkit-tui",
  "version": "0.4.1",
  "description": "Composable terminal UI for the Stitchkit headless agent runtime",
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/tui"
  },
  "type": "module",
  "bin": {
    "stitchkit-agent": "./dist/cli.js",
    "stitchkit-tui-gallery": "./dist/gallery/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts src/core/index.ts src/widgets/index.ts src/build/index.ts src/testing/index.tsx src/gallery/main.ts --root src --outdir dist --target bun --packages external --splitting && bun x tsc -p tsconfig.build.json --emitDeclarationOnly && chmod +x dist/cli.js dist/gallery/main.js",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "ai": "^7.0.162",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opentui/core": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "react": "^19.3.1",
    "stitchkit": "workspace:^"
  },
  "peerDependenciesMeta": {
    "stitchkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "stitchkit": "workspace:^",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.4"
}
