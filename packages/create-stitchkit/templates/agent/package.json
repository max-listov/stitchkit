{
  "name": "stitchkit-agent-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "catalog": {
    "stitchkit-tui": "^0.1.1"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "bun x tsgo --noEmit",
    "lint": "bun x biome check --error-on-warnings .",
    "lint:fix": "bun x biome check --write .",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun --packages external"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.162",
    "stitchkit": "link:../../../core",
    "stitchkit-tui": "link:../../../tui",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.4"
}
