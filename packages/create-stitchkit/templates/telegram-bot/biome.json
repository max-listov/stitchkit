{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "markdown": {
    "formatter": { "enabled": false }
  },
  "files": {
    "includes": ["**", "!!node_modules", "!!dist", "!!project.json", "!!**/.data"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 96
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noUnknownAttribute": "off"
      }
    }
  }
}
