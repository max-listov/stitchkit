{
  "name": "create-stitchkit",
  "version": "0.4.4",
  "description": "Create a production-shaped Stitchkit application",
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/create-stitchkit"
  },
  "type": "module",
  "bin": {
    "create-stitchkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template/**/*",
    "templates/**/*",
    "examples/**/*",
    "!template/**/.env",
    "!template/**/.build-stamp.json",
    "!template/**/node_modules/**",
    "!template/**/.next/**",
    "!template/**/.stitchkit/**",
    "!template/**/dist/**",
    "!template/**/playwright-report/**",
    "!template/**/test-results/**",
    "!template/**/next-env.d.ts",
    "!template/**/src/generated/**",
    "!template/**/*.log",
    "!template/**/*.tsbuildinfo",
    "!template/**/coverage/**",
    "!templates/**/.env",
    "!templates/**/.build-stamp.json",
    "!templates/**/node_modules/**",
    "!templates/**/.next/**",
    "!templates/**/.stitchkit/**",
    "!templates/**/dist/**",
    "!templates/**/playwright-report/**",
    "!templates/**/test-results/**",
    "!templates/**/next-env.d.ts",
    "!templates/**/src/generated/**",
    "!templates/**/*.log",
    "!templates/**/*.tsbuildinfo",
    "!templates/**/coverage/**",
    "!templates/agent/bun.lock",
    "!examples/**/.env",
    "!examples/**/.build-stamp.json",
    "!examples/**/node_modules/**",
    "!examples/**/.next/**",
    "!examples/**/.stitchkit/**",
    "!examples/**/dist/**",
    "!examples/**/coverage/**",
    "!examples/**/playwright-report/**",
    "!examples/**/test-results/**",
    "!examples/**/next-env.d.ts",
    "!examples/**/src/generated/**",
    "!examples/**/*.log",
    "!examples/**/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md",
    "UPGRADING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "test": "bun test tests",
    "build": "rm -rf dist && bun build src/cli.ts --outdir dist --target bun --packages external && chmod +x dist/cli.js",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "ai": "^7.0.84",
    "react": "^19.2.8",
    "stitchkit": "workspace:*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14"
}
