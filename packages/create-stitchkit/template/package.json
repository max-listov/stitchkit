{
  "name": "stitchkit-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "stitchkit": "^0.49.2"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "check": "bun run db:generate && bun run check:authored && bun x tsc -p tsconfig.json --noEmit && bun run --filter '*' check",
    "check:authored": "bun scripts/check-authored.ts",
    "test": "bun run --filter '*' test",
    "build": "bun run db:generate && bun --filter @app/backend build && bun --filter @app/frontend build",
    "start:api": "bun --filter @app/backend start",
    "start:web": "bun --filter @app/frontend start",
    "env:ensure": "bun scripts/local-env.ts",
    "db:setup": "bun run db:generate && bun run db:deploy",
    "db:generate": "bun run env:ensure && bun --filter @app/db db:generate",
    "db:migrate": "bun --filter @app/db db:migrate",
    "db:deploy": "bun --filter @app/db db:deploy",
    "db:studio": "bun --filter @app/db db:studio",
    "cli": "bun packages/backend/src/cli.ts",
    "tools": "bun packages/backend/src/tools.ts",
    "runtime:smoke": "bun scripts/runtime-smoke.ts",
    "surface:snapshot": "bun scripts/surface-snapshot.ts",
    "e2e": "playwright test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "pm2:dev": "bun scripts/dev.ts",
    "pm2:prod": "bun run db:deploy && pm2 startOrReload ecosystem.config.cjs --update-env"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@app/shared": "workspace:*",
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "^2.5.7",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "oxc-parser": "^0.143.0",
    "socket.io-client": "^4.8.3",
    "stitchkit": "catalog:",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
