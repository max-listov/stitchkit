NODE_ENV=development
# Replace USER:PASSWORD before the first `bun run dev` — it refuses to start
# while they are here. The role also needs CREATEDB if it will run
# `db:migrate`: `prisma migrate dev` creates a shadow database to diff against.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/stitchkit_starter
# The throwaway database `bun run acceptance:local` creates and writes to. The
# runtime gates WRITE, so they get one of their own: the harness refuses to
# start if this is unset or names the database above.
ACCEPTANCE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/stitchkit_starter_acceptance
# 0.0.0.0 exposes the app to every network interface — opt in consciously.
BIND_HOST=127.0.0.1
API_PORT=3211
WEB_PORT=3210
SMOKE_API_ORIGIN=http://127.0.0.1:3211
SMOKE_WEB_ORIGIN=http://127.0.0.1:3210
# Hosts this deployment answers for, comma-separated. One built artifact can
# serve several addresses; a forwarded host outside this list is refused rather
# than believed. Leave unset and set PUBLIC_WEB_ORIGIN instead for a single one.
#
# `bun run acceptance:local` supplies its own list to the deployment it creates,
# so the addresses the portability check needs are not policy this project
# carries. List here only the hosts this deployment really answers for.
PUBLIC_WEB_HOSTS=127.0.0.1:3210
LOG_FORMAT=pretty

# The web role reaches the API role internally, and forwards the browser's
# same-origin `/api/…` calls to it (packages/frontend/src/app/api/[...path]).
INTERNAL_API_URL=http://127.0.0.1:3211

# The realtime socket, and ONLY it. A WebSocket upgrade does not survive the
# route handler that forwards `/api`, so two roles on two loopback ports must
# name the socket's origin even though their HTTP is already same-origin.
# Behind one routing layer that forwards `/socket.io`, leave this unset.
PUBLIC_REALTIME_ORIGIN=http://127.0.0.1:3211

# The browser origin the API role admits — for HTTP and for the realtime
# handshake alike. Needed here because the socket above is cross-origin.
CORS_ORIGIN=http://127.0.0.1:3210
