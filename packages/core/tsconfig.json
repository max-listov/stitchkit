{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "stitchkit/agent-runtime": ["./src/agent-runtime.ts"],
      "stitchkit/application": ["./src/application.ts"],
      "stitchkit/application/grammy": ["./src/application-grammy.ts"],
      "stitchkit/tools": ["./src/tools.ts"]
    }
  },
  "include": ["src", "tests", "examples"],
  "exclude": ["tests/fixtures/next-ssr-retry"]
}
