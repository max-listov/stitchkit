  "reviewed": [
    {
      "entrypoint": "stitchkit/cli",
      "names": [
        "RuntimeToolDefinition",
        "RuntimeToolDefinitionWithOutput",
        "RuntimeToolDefinitionWithoutOutput"
      ],
      "reason": "A CLI-only consumer can name heterogeneous registration and construct strict schema-aware output/void definitions without importing optional SDK declarations; the CLI ceiling holds exactly these three contracts (ADRs 0227 and 0236)."
    },
    {
      "entrypoint": "stitchkit/tools",
      "names": ["MountableTool", "ToolOperation"],
      "reason": "Documented shapes a caller holds: MountableTool is what collectTools returns, ToolOperation the path-free operation both runners execute; exported so the value can be named, not re-derived with Parameters<…>."
    },
    {
      "entrypoint": "stitchkit/tools",
      "names": ["EXT_APPS_BUNDLE_PLACEHOLDER", "MCP_CATALOG_META_KEY"],
      "reason": "Documented constants of the MCP surface: the token inlineMcpAppBundle replaces and the namespaced _meta key a client reads the catalog stamp under."
    },
    {
      "entrypoint": "stitchkit/tools",
      "names": ["AgentStoreEventEnvelope", "AppendAgentStoreEvent", "ReadAgentStoreEvents"],
      "reason": "The event-log vocabulary the durability engine speaks; it lives in the neutral durability part (ADR 0197) and a tools-only consumer of createLocalStepDurability names these types."
    },
    {
      "entrypoint": "stitchkit/application",
      "names": [
        "DirectoryInboxAccept",
        "DirectoryInboxAcceptResult",
        "DirectoryInboxAcceptResultSchema",
        "DirectoryInboxIdentity",
        "DirectoryInboxIdentitySchema",
        "StateStoreUpdateContext"
      ],
      "reason": "Six named intake identity/accept/result and protected transaction contracts qualify durable programmatic acceptance and fenced state adapters over the existing inbox owner (ADR 0228)."
    },
    {
      "entrypoint": "stitchkit/cli/publish",
      "names": [
        "publishCli",
        "CliPublicationOptions",
        "CliPublicationPhase",
        "CliPublicationResult"
      ],
      "reason": "Exactly four opt-in bounded transactional publication names reuse the existing manifest, signatures, codec, filesystem and exclusive lock owners (ADR 0230); they live in their own evolving leaf because release infrastructure cannot hold the stable promise of stitchkit/cli (ADR 0245)."
    },
    {
      "entrypoint": "stitchkit/telegram",
      "names": ["TelegramBroadcastFailure", "TelegramBroadcastFailureSchema"],
      "reason": "One validated failure union enables injected send classification, bounded exact delays and explicit uncertain outcomes without a transport-specific retry engine (ADR 0228)."
    },
    {
      "entrypoint": "stitchkit/tools/connections",
      "names": [
        "ConnectionOperation",
        "ConnectionPhase",
        "ConnectionFailureContext",
        "ConnectionOperationLimits",
        "McpConnectionLimits",
        "ConnectionTimeoutError",
        "ConnectionResponseTooLargeError"
      ],
      "reason": "Seven names expose existing typed failures, their constructor context and independently bounded discovery/call policy; no new hierarchy or transport adapter (ADR 0229)."
    },
    {
      "entrypoint": "stitchkit/server",
      "names": ["NormalizeErrorOptions"],
      "reason": "The existing public normalizer must name its optional logging policy; tool observers keep the full cause while expected and unknown tool failures remain safe on stderr (ADR 0229)."
    },
    {
      "entrypoint": "stitchkit/tools/mcp",
      "names": ["RuntimeMcpToolPresenters"],
      "reason": "The MCP presenter extension of the one runtime-tool declaration is named without inheriting an AI default; other leaf names re-export established owners (ADRs 0231 and 0236)."
    },
    {
      "entrypoint": "stitchkit/tools",
      "names": ["ToolSurfaceProjection"],
      "reason": "One explicit generic readonly container names the shared public base of full and MCP-only surfaces; executable adapters supply their own definitions without peer closure leakage (ADR 0231)."
    }
  ]
}
