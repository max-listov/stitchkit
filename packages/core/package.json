{
  "name": "stitchkit",
  "version": "0.65.0",
  "description": "Contract-first backend framework — one defineContract() into an HTTP API, MCP tools, AI-agent tools and a typed client. Bun and Node.",
  "keywords": [
    "bun",
    "node",
    "framework",
    "contract-first",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-tools",
    "typescript",
    "rpc",
    "api",
    "zod",
    "typed-client",
    "socket.io"
  ],
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/max-listov/stitchkit#readme",
  "bugs": {
    "url": "https://github.com/max-listov/stitchkit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime.d.ts",
      "import": "./dist/agent-runtime.js"
    },
    "./agent-runtime/openrouter": {
      "types": "./dist/agent-runtime-openrouter.d.ts",
      "import": "./dist/agent-runtime-openrouter.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./application/grammy": {
      "types": "./dist/application-grammy.d.ts",
      "import": "./dist/application-grammy.js"
    },
    "./application/opentelemetry": {
      "types": "./dist/application-opentelemetry.d.ts",
      "import": "./dist/application-opentelemetry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./declaration": {
      "types": "./dist/declaration.d.ts",
      "import": "./dist/declaration.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "build:browser": "bun build src/index.ts src/react.ts src/contract/index.ts src/declaration.ts --outdir dist --target node --packages external --splitting --root src",
    "build:server": "bun build src/server/index.ts src/node.ts src/tools.ts src/cli.ts src/remote.ts src/files.ts src/testing.ts src/observability/index.ts src/agent-runtime.ts src/agent-runtime-openrouter.ts src/application.ts src/application-grammy.ts src/application-opentelemetry.ts --outdir dist --target node --packages external --splitting --root src",
    "build:js": "bun run build:browser && bun run build:server",
    "build:types": "bun x tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "rm -rf dist && bun run build:js && bun run build:types && bun scripts/check-browser-clean.mjs && bun scripts/check-env-live.mjs && bun scripts/check-public-types.mjs",
    "dev": "bun run build:js -- --watch",
    "prepack": "cp ../../README.md ./README.md && bun ../../scripts/gen-llms.ts && bun run build",
    "test": "bun test",
    "smoke:node": "node scripts/node-smoke.mjs",
    "smoke:next-ssr": "node scripts/next-ssr-retry-smoke.mjs",
    "consumer-lane": "bun scripts/consumer-lane/run.mjs",
    "bench:mcp-preparation": "bun scripts/benchmark-mcp-preparation.ts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": ">=5",
    "ai": "^7.0.0",
    "grammy": "^1.45.1",
    "react": ">=18",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.12.5",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "@socket.io/bun-engine": {
      "optional": true
    },
    "@socket.io/component-emitter": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "grammy": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-query-kit": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "srvx": {
      "optional": true
    }
  },
  "dependencies": {
    "ky": "^2.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": "5.102.3",
    "@types/bun": "^1.4.0",
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19.2.18",
    "@typescript/typescript6": "^6.0.2",
    "ai": "^7.0.79",
    "grammy": "^1.45.1",
    "react": "^19.2.8",
    "react-query-kit": "^3.3.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.12.7",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
