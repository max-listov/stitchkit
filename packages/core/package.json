{
  "name": "stitchkit",
  "version": "0.94.0",
  "description": "Contract-first backend framework — one defineContract() into an HTTP API, MCP tools, AI-agent tools and a typed client. Bun and Node.",
  "keywords": [
    "bun",
    "node",
    "framework",
    "contract-first",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-tools",
    "typescript",
    "rpc",
    "api",
    "zod",
    "typed-client",
    "socket.io"
  ],
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/max-listov/stitchkit#readme",
  "bugs": {
    "url": "https://github.com/max-listov/stitchkit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "bin": {
