{
  "name": "stitchkit",
  "version": "0.82.0",
  "description": "Contract-first backend framework — one defineContract() into an HTTP API, MCP tools, AI-agent tools and a typed client. Bun and Node.",
  "keywords": [
    "bun",
    "node",
    "framework",
    "contract-first",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-tools",
    "typescript",
    "rpc",
    "api",
    "zod",
    "typed-client",
    "socket.io"
  ],
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/max-listov/stitchkit#readme",
  "bugs": {
    "url": "https://github.com/max-listov/stitchkit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "bin": {
    "stitchkit": "./dist/upgrade-cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native/*.node",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./tools/contract": {
      "types": "./dist/tools-contract.d.ts",
      "import": "./dist/tools-contract.js"
    },
    "./tools/invoker": {
      "types": "./dist/tool-invoker.d.ts",
      "import": "./dist/tool-invoker.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime.d.ts",
      "import": "./dist/agent-runtime.js"
    },
    "./agent-runtime/harness": {
      "types": "./dist/agent-runtime-harness.d.ts",
      "import": "./dist/agent-runtime-harness.js"
    },
    "./agent-runtime/coding-tools": {
      "types": "./dist/agent-runtime-coding-tools.d.ts",
      "import": "./dist/agent-runtime-coding-tools.js"
    },
    "./agent-runtime/browser": {
      "types": "./dist/agent-runtime-browser.d.ts",
      "import": "./dist/agent-runtime-browser.js"
    },
    "./agent-runtime/openrouter": {
      "types": "./dist/agent-runtime-openrouter.d.ts",
      "import": "./dist/agent-runtime-openrouter.js"
    },
    "./agent-runtime/sqlite/bun": {
      "types": "./dist/agent-runtime-sqlite-bun.d.ts",
      "import": "./dist/agent-runtime-sqlite-bun.js"
    },
    "./agent-runtime/sqlite/node": {
      "types": "./dist/agent-runtime-sqlite-node.d.ts",
      "import": "./dist/agent-runtime-sqlite-node.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./application/grammy": {
      "types": "./dist/application-grammy.d.ts",
      "import": "./dist/application-grammy.js"
    },
    "./application/opentelemetry": {
      "types": "./dist/application-opentelemetry.d.ts",
      "import": "./dist/application-opentelemetry.js"
    },
    "./application/diagnostic-journal": {
      "types": "./dist/application-diagnostic-journal.d.ts",
      "import": "./dist/application-diagnostic-journal.js"
    },
    "./application/schemas": {
      "types": "./dist/application-schemas.d.ts",
      "import": "./dist/application-schemas.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js"
    },
    "./tracking": {
      "types": "./dist/tracking.d.ts",
      "import": "./dist/tracking.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "import": "./dist/release.js"
    },
    "./tracking/server": {
      "types": "./dist/tracking-server.d.ts",
      "import": "./dist/tracking-server.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js"
    },
    "./declaration": {
      "types": "./dist/declaration.d.ts",
      "import": "./dist/declaration.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:native-contained-files": "node scripts/build-contained-files-native.mjs",
    "check": "bun x tsc --noEmit",
    "build:js": "bun run build:entrypoints && bun scripts/preserve-webpack-ignore.mjs",
    "build:types": "bun x tsc -p tsconfig.build.json --emitDeclarationOnly && bun scripts/rewrite-declaration-specifiers.mjs",
    "build": "rm -rf dist && cp ../../CHANGELOG.md ./CHANGELOG.md && bun run build:js && chmod +x dist/upgrade-cli.js && bun run build:types && bun scripts/check-browser-clean.mjs && bun scripts/check-browser-executes.mjs && bun scripts/check-env-live.mjs && bun scripts/check-public-types.mjs && bun scripts/check-declarations-strict.mjs",
    "dev": "bun run build:entrypoints -- --watch",
    "prepack": "cp ../../README.md ./README.md && bun ../../scripts/gen-llms.ts && bun run build",
    "test": "bun test",
    "smoke:node": "node scripts/node-smoke.mjs",
    "smoke:next-ssr": "node scripts/next-ssr-retry-smoke.mjs",
    "consumer-lane": "bun scripts/consumer-lane/run.mjs",
    "bench:mcp-preparation": "bun scripts/benchmark-mcp-preparation.ts",
    "build:entrypoints": "bun scripts/build-entrypoints.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": ">=5",
    "@types/bun": "^1.3.14",
    "ai": "^7.0.0",
    "grammy": "^1.45.1",
    "maxmind": "^5.0.7",
    "react": ">=18",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.12.5",
    "zod": "^4.4.3"
  },
