    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": "5.102.3",
    "@types/bun": "^1.4.0",
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19.2.18",
    "@typescript/typescript6": "^6.0.2",
    "ai": "^7.0.79",
    "fake-indexeddb": "^6.2.5",
