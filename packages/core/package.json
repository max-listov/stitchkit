    "react": ">=18",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.12.5 || ^1.0.5",
    "zod": "^4.6.5"
