{
  "name": "stitchkit",
  "version": "0.31.0",
  "description": "Contract-first backend framework — one defineContract() into an HTTP API, MCP tools, AI-agent tools and a typed client. Bun and Node.",
  "keywords": [
    "bun",
    "node",
    "framework",
    "contract-first",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-tools",
    "typescript",
    "rpc",
    "api",
    "zod",
    "typed-client",
    "socket.io"
  ],
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-listov/stitchkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/max-listov/stitchkit#readme",
  "bugs": {
    "url": "https://github.com/max-listov/stitchkit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "build:browser": "bun build src/index.ts src/react.ts src/contract/index.ts --outdir dist --target node --packages external --splitting --root src",
    "build:server": "bun build src/server/index.ts src/node.ts src/tools.ts src/cli.ts src/observability/index.ts --outdir dist --target node --packages external --splitting --root src",
    "build:js": "bun run build:browser && bun run build:server",
    "build:types": "bun x tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "rm -rf dist && bun run build:js && bun run build:types && bun scripts/check-browser-clean.mjs && bun scripts/check-env-live.mjs",
    "dev": "bun run build:js -- --watch",
    "prepublishOnly": "cp ../../README.md ./README.md && bun ../../scripts/gen-llms.ts && bun run build",
    "test": "bun test",
    "smoke:node": "node scripts/node-smoke.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.14",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": ">=5",
    "ai": "^7.0.0",
    "react": ">=18",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.11.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@socket.io/bun-engine": {
      "optional": true
    },
    "@socket.io/component-emitter": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-query-kit": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "srvx": {
      "optional": true
    }
  },
  "dependencies": {
    "ky": "^2.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": "5.101.1",
    "@types/bun": "^1.3.14",
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19.2.17",
    "ai": "^7.0.2",
    "react": "^19.2.7",
    "react-query-kit": "^3.3.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "srvx": "^0.11.17",
    "typescript": "^6",
    "zod": "^4.4.3"
  }
}
