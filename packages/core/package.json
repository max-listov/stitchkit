{
  "name": "stitchkit",
  "version": "0.1.0",
  "description": "Contract-first backend framework for Bun — one defineContract() into an HTTP API, MCP tools, AI-agent tools and a typed client.",
  "keywords": [
    "bun",
    "framework",
    "contract-first",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "ai-tools",
    "typescript",
    "rpc",
    "api",
    "zod",
    "typed-client",
    "socket.io"
  ],
  "license": "MIT",
  "author": "Max Listov <maxlistov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxlistov/stitchkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/maxlistov/stitchkit#readme",
  "bugs": {
    "url": "https://github.com/maxlistov/stitchkit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun x tsc --noEmit",
    "build:js": "bun build src/index.ts src/react.ts src/tools.ts src/contract/index.ts src/server/index.ts src/observability/index.ts --outdir dist --target node --packages external --splitting --root src",
    "build:types": "bun x tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "dev": "bun run build:js -- --watch",
    "prepublishOnly": "cp ../../README.md ./README.md && bun run build",
    "test": "bun test"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": ">=5",
    "ai": "^6.0.182",
    "react": ">=18",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@socket.io/bun-engine": {
      "optional": true
    },
    "@socket.io/component-emitter": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-query-kit": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "dependencies": {
    "ky": "^2.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@socket.io/component-emitter": "^3.1.2",
    "@tanstack/react-query": "5.100.11",
    "@types/bun": "^1.3.14",
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19.2.15",
    "ai": "^6.0.185",
    "react": "^19.2.0",
    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6",
    "zod": "^4.4.3"
  }
}
