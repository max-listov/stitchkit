    "react-query-kit": "^3.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stitchkit": "workspace:*",
    "tailwindcss": "^4.2.2",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
